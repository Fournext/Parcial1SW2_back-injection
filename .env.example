# Configuración General
DEBUG=True
SECRET_KEY=django-insecure-cambiar-esta-clave-secreta-en-produccion-12345
DJANGO_ENV=development

# Base de Datos PostgreSQL Obligatoria (Variables separadas)
DB_NAME=db_genvulnai
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432


# Seguridad y URLs/Hosts Autorizados para Análisis (lista separada por comas)
# Permite URLs completas (ej. http://localhost:3000), host con puerto (localhost:5000), dominios, IPs o '*' para todos
ALLOWED_TARGET_URLS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:8000
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,0.0.0.0


# Configuración de Playwright y Escaneo
PLAYWRIGHT_HEADLESS=True
DISCOVERY_TIMEOUT_SECONDS=30
MAX_CAPTURED_REQUESTS=500
MAX_BODY_BYTES=51200

# Configuración de Ollama (IA Semántica Local)
OLLAMA_ENABLED=True
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=15.0
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_RETRIES=2
OLLAMA_MIN_HEURISTIC_CONFIDENCE=0.80

# Configuración del Motor de Ataque y Evaluación
ATTACK_MAX_TURNS=20
ATTACK_RESET_CONSECUTIVE_FAILURES=3
ATTACK_A1_MODEL=hf.co/dthryjdrk/Qwen2.5-VL-7B-Instruct-abliterated-Q8_0-GGUF:Q8_0
ATTACK_J1_MODEL=hf.co/unsloth/Qwen3.5-4B-GGUF:UD-Q4_K_XL
ATTACK_A1_TEMPERATURE=0.7
ATTACK_J1_TEMPERATURE=0.1
ATTACK_D1_TIMEOUT_SECONDS=120.0
ATTACK_J1_MAX_TOKENS=768
